{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        // "useSortedKeys": "on",
        "useSortedPackageJson": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true,
      "selfCloseVoidElements": "always"
    }
  },
  "linter": {
    "domains": {
      "project": "recommended",
      "types": "recommended"
    },
    "rules": {
      "complexity": {
        "noForEach": "warn",
        "noUselessReturn": "warn",
        "noUselessStringConcat": "warn"
      },
      "correctness": {
        "useImportExtensions": "warn"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noFloatingPromises": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "warn",
        "noMisusedPromises": "error",
        "noObsoleteTags": "warn",
        "noSvelteAtDebugTags": "warn",
        "noSvelteInspect": "warn",
        "noSvelteLegacyConst": "info",
        "noSvelteUselessDerivedBy": "warn",
        "noUselessAssignment": "info",
        "useAwaitThenable": "warn",
        "useExhaustiveSwitchCases": "info",
        "useTailwindShorthandClasses": "warn",
        "useTailwindSortedClasses": "warn"
      },
      "performance": {
        // Useful ot check once in a while.
        // "noAwaitInLoops": "warn"
      },
      "style": {
        "useAsConstAssertion": "warn",
        "useConsistentBuiltinInstantiation": "warn",
        "useImportsFirst": "warn"
      },
      "suspicious": {
        "noForIn": "error",
        "noUnassignedVariables": "warn",
        "noVar": "warn",
        "useAwait": "warn"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
