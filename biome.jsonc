{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",

  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on"
      }
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },

  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true,
      "selfCloseVoidElements": "always"
    }
  },

  "linter": {
    "domains": {
      "project": "recommended",
      "types": "recommended"
    },
    "rules": {
      "correctness": {
        "useImportExtensions": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },

  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
