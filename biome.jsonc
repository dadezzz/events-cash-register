{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",

  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on"
      }
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },

  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": false,
      "indentScriptAndStyle": true,
      "selfCloseVoidElements": "always"
    }
  },

  "linter": {
    "domains": {
      "project": "recommended",
      "types": "recommended"
    },
    "rules": {
      "correctness": {
        "useImportExtensions": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },

  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    },

    {
      "includes": ["./src/app.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useValidLang": "off"
          }
        }
      }
    }
  ],

  // We need to set every ignored file in the root .gititgnore or extend this
  // configuration with a biome.jsonc file inside every package.
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
