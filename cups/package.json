{
  "name": "@workspace/cups",
  "type": "module",
  "exports": {
    ".": "./dist/ts/index.js",
    "./utils": "./dist/ts/utils.js"
  },
  "files": [
    "dist/",
    "build/cups.node"
  ],
  "scripts": {
    "build": "meson compile -C build && rm -rf dist/ && tsc",
    "clean": "rm -rf .cache/ build/ dist/ node_modules/",
    "format:check": "ninja -C build clang-format-check",
    "format:fix": "ninja -C build clang-format",
    "lint:check": "ninja -C build clang-tidy",
    "lint:fix": "ninja -C build clang-tidy-fix",
    "setup": "meson setup build"
  },
  "dependencies": {
    "node-addon-api": "8.9.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/node": "26.1.2"
  }
}
