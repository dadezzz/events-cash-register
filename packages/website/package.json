{
  "name": "@workspace/website",
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
    "clean": "rm -rf ./dist ./node_modules ./.svelte-kit",
    "dev": "svelte-kit sync && vite dev",
    "drizzle": "drizzle-kit",
    "lint:check": "biome check",
    "lint:fix": "biome check --fix",
    "preview": "vite preview",
    "setup": "if [ ! -f .env ]; then cp ../../.env.example .env ; fi",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@node-rs/argon2": "2.2.1",
    "@workspace/cups": "workspace:*",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.3",
    "handlebars": "4.7.9",
    "puppeteer-core": "25.12.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/enhanced-img": "1.0.0",
    "@sveltejs/kit": "3.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@toolwind/anchors": "1.0.10",
    "@types/node": "25.9.9",
    "drizzle-kit": "0.31.11",
    "phosphor-svelte": "3.1.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
