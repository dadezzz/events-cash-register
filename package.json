    "format:fix": "turbo format:fix && biome format --fix && prettier --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.11"
  },
  "packageManager": "pnpm@11.24.0"
}
