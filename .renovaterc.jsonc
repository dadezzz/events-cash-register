{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    "customManagers:biomeVersions",
    ":semanticCommits"
  ],
  "packageRules": [
    // Rebuild the container if something is updated in the Dockerfile.
    {
      "automerge": true,
      "matchFileNames": ["Dockerfile"],
      "semanticCommitType": "fix"
    },
    // Automerge and group devcontainer, actions and ci deps.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".devcontainer/**", ".forgejo/**", "ci.Dockerfile", "cups.Dockerfile"]
    },
    // Automerge the ci image and don't trigger a release even in Dockerfile.
    // Also group the pnpm in the packageManager in package.json.
    // Formatters and linters get automerged.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchPackageNames": [
        "git.zarantonello.dev/infra/ci-pnpm",
        "svelte-check",
        "@biomejs/biome",
        "@types/*",
        "pnpm",
        "vitest",
        "turbo"
      ]
    },
    // These are devDependencies but they can cause user visible changes.
    {
      "matchPackageNames": [
        "@sveltejs/adapter-node",
        "@sveltejs/enhanced-img",
        "@sveltejs/kit",
        "@tailwindcss/vite",
        "bits-ui",
        "phospor-svelte",
        "svelte",
        "tailwindcss",
        "vite"
      ],
      "semanticCommitType": "fix"
    }
  ],
  // Raise limit or there are situations where we can't keep up with the number
  // of deps to update.
  "prHourlyLimit": 6
}
