{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    "customManagers:biomeVersions",
    ":semanticCommits"
  ],
  "packageRules": [
    // Rebuild the container if something is updated in the Dockerfile.
    {
      "automerge": true,
      "matchFileNames": ["Dockerfile"],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "fix"
    },
    {
      "matchFileNames": ["Dockerfile"],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat"
    },
    // Automerge and group devcontainer, actions and ci deps.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".devcontainer/**", ".forgejo/**", "ci.Dockerfile", "cups.Dockerfile"],
      "matchUpdateTypes": ["!major"]
    },
    // Automerge the ci image and don't trigger a release even in Dockerfile.
    // Also group the pnpm in the packageManager in package.json.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchPackageNames": ["git.zarantonello.dev/infra/ci-pnpm", "pnpm"],
      "semanticCommitType": "ci"
    },
    // Formatters and linters get automerged.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchPackageNames": ["svelte-check", "@biomejs/biome", "@types/*", "prettier*", "pnpm", "vitest", "turbo"],
      "matchUpdateTypes": ["!major"]
    },
    // These are devDependencies but they can cause user visible changes.
    {
      "matchPackageNames": [
        "@sveltejs/adapter-node",
        "@sveltejs/enhanced-img",
        "@sveltejs/kit",
        "@tailwindcss/vite",
        "bits-ui",
        "phospor-svelte",
        "svelte",
        "tailwindcss",
        "vite"
      ],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "fix"
    },
    // Like above but for major versions we use feat.
    {
      "matchPackageNames": [
        "@sveltejs/adapter-node",
        "@sveltejs/enhanced-img",
        "@sveltejs/kit",
        "@tailwindcss/vite",
        "bits-ui",
        "phospor-svelte",
        "svelte",
        "tailwindcss",
        "vite"
      ],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat"
    }
  ],
  // Raise limit or there are situations where we can't keep up with the number
  // of deps to update.
  "prHourlyLimit": 6
}
